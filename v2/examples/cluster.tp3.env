# cluster.sh's settings for the reference ring (TP=3). 参照機のリング（TP=3）の cluster.sh の設定。
TP=3
HOSTS="edgexpert01 edgexpert02 edgexpert03" # SSH names in rank order: rank 0 serves HTTP
CHECKOUT='$HOME/GLM-5.3-Flash-DGX-Sparks-BIZ'  # this repository on every host (expanded there); hostwatch.sh runs from it
