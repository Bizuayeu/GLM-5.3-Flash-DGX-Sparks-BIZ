# TP=2 rank 1 on the reference pair (edgexpert02): copy to /work/rank.env on that host and put your own values.
# 参照機の対のTP=2 rank 1（edgexpert02）。そのホストの /work/rank.env にコピーし、自分の値に直す。
# The values are the reference pair's; 1.x uses the same link, HCA and GID.
# Sourced by serve.sh with `set -a; . file`.
VISION=1                        # image input (serve.sh adds --vision; 0: off), the same on every rank
TRITON_CACHE_DIR=/work/triton-cache   # the kernels Triton compiles, on the /work mount: a new container compiles only those that changed
#                               # (unset: inside the container, compiled again on its first long prompt; validation.md)
# CHECKPOINT=/hub/models--Bizuayeu--GLM-5.3-Flash-NVFP4-attn-lmhead-W4A16/snapshots/bbad98c8f380588c16a2326bf5a2ab7344190b07
#                               # the published AXL weights instead of the pinned snapshot (README, Weights); every rank the same
MASTER=10.41.12.1                               # rank 0's address on the direct link
NCCL_NET=IB                                     # named, as TP=3 and 1.x name it (2026-10-05: every connection was NET/IB either way)
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0        # 2 rails, the 2.x default (1 rail: rocep1s0f0 alone)
NCCL_IB_GID_INDEX=3                             # the RoCE v2 entry on these ports
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_MIN_NCHANNELS=4                            # 4 channels, as TP=3: decode +1%, about 1.5 GiB more room at start (decisions.md)
NCCL_MAX_NCHANNELS=4
NCCL_SOCKET_IFNAME=enp1s0f0np0              # bootstrap over the link's interface
NCCL_SOCKET_FAMILY=AF_INET
NCCL_DEBUG=INFO                 # NCCL logs each connection's transport once at start (SETUP §6 reads NET/IB)
NCCL_DEBUG_SUBSYS=INIT,NET
