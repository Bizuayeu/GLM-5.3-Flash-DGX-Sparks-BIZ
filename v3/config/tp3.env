# TP=3's serving defaults: several people at once.
# serve.sh reads this file, then the rank file, so a rank file's line wins and an empty value turns a setting off
# (docs/configuration.md). The reasons and the numbers behind each value are in docs/decisions.md.
CONTEXT=1048576                 # the window, the model's limit
PARALLEL=8                      # eight prompts run at once, not four and a queue
TF_GLM_KV_SHARE=32              # kept prompts on the pool's pages, four a stream
TENSORFOLD_PREFILL_SHARE=0.7    # a prompt leaves the decodes beside it room to go on
TF_GLM_CHUNK_SOLO=              # off
MTP_CONFIDENCE=0.5              # a stream's drafts follow how sure the head is
TF_GLM_ROCE_MULTI=1             # the wire: the small all-gathers on RoCE beside NCCL
TENSORFOLD_MEMORY_RESERVE_GIB=14  # the pool stays at two windows, clear of the room where a third would take the memory left
