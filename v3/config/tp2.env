# TP=2's serving defaults: one agent's long conversation, with a short request beside it now and then.
# serve.sh reads this file, then the rank file, so a rank file's line wins and an empty value turns a setting off
# (docs/configuration.md). The reasons and the numbers behind each value are in docs/decisions.md.
CONTEXT=524288                  # the window
PARALLEL=4                      # a short request beside a long prompt starts in about a second
TF_GLM_KV_SHARE=16              # kept prompts on the pool's pages, four a stream; a long state outlives the next prompt
TENSORFOLD_PREFILL_SHARE=0.7    # a prompt leaves a decode beside it room to go on
TF_GLM_CHUNK_SOLO=4096          # a prompt with no stream beside it runs in passes of 4096 rows
MTP_CONFIDENCE=                 # off: a single sampled stream takes the same drafts
TF_GLM_ROCE_MULTI=              # off: the wire is for three ranks or more
