# The 3.x runtime image: what TensorFold's native engine needs on a GB10 to run (tensorfold-native, tf-cuda-test),
# nothing it builds. The binaries carry their kernels and link libc alone; at run time they open the driver's
# libcuda.so.1 (from the host through the NVIDIA runtime) and libnccl.so.2 (here). Build from the checkout root:
#   docker build -f v3/docker/Dockerfile.runtime -t tf3-runtime:20261014 .
# The base by digest, not by tag (a tag can move): CUDA 13.3.1 on Ubuntu 24.04 (glibc 2.39; the engine needs 2.36).
ARG BASE_IMAGE=nvidia/cuda:13.3.1-runtime-ubuntu24.04@sha256:63da350831208559df18c7b8f3e0d5d1c984eaa815cdde690aacd6606cd0cb11
FROM ${BASE_IMAGE}

# NCCL as measured on the reference pair and in the 04/05 NCCL check (2.30.7), held there; rdma-core's verbs and
# their providers so NCCL takes RoCE (NET/IB) rather than sockets; python3 with tokenizers for the HTTP checks.
ARG NCCL_VERSION=2.30.7-1+cuda13.3
ARG TOKENIZERS_VERSION=0.23.1
RUN apt-get update \
 && apt-get install -y --no-install-recommends --allow-downgrades --allow-change-held-packages \
      "libnccl2=${NCCL_VERSION}" libibverbs1 ibverbs-providers rdma-core ibverbs-utils \
      python3 python3-pip curl procps util-linux ca-certificates \
 && apt-mark hold libnccl2 \
 && pip3 install --no-cache-dir --break-system-packages "tokenizers==${TOKENIZERS_VERSION}" \
 && rm -rf /var/lib/apt/lists/*

COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/tf3/
WORKDIR /work
