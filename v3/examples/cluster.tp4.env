# cluster.sh's settings for the reference ring of four (TP=4), experimental. 参照機の四台のリング（TP=4、試験的）の cluster.sh の設定。
TP=4
HOSTS="edgexpert04 edgexpert05 edgexpert07 edgexpert06" # SSH names in rank order round the ring: rank 0 serves HTTP
CHECKOUT='$HOME/GLM-5.3-Flash-DGX-Sparks-BIZ'  # this repository on every host (expanded there); hostwatch.sh runs from it
# SSH="ssh -F ~/.ssh/config.glm -o ConnectTimeout=20"
# CONTAINER=glm53-tf3                  # create_container.sh's default
# WORK='$HOME/glm53-tf3'               # the host directory at /work, as given to create_container.sh
