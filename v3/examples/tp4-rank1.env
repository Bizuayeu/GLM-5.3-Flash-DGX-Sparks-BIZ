# TP=4 rank 1 on the reference ring of four (edgexpert05): copy to /work/rank.env on that host, and
# examples/tp4-rank1.graph.xml to /work/graph.xml, and put your own values. Experimental.
# 参照機の四台のリングのTP=4 rank 1（edgexpert05）。そのホストの /work/rank.env に、tp4-rank1.graph.xml を /work/graph.xml にコピーし、自分の値に直す。試験的。
# The ring is 04 -> 05 -> 07 -> 06 -> 04 with no cable across (04-07, 05-06), so the ranks go round it in that order.
# Measured from 2026-11-07 on upstream's main: every channel over NET/IB with GID 3 on the links; rank 1 receives from
# edgexpert04 on its port 2 and sends to edgexpert07 on its port 1.
# Sourced by serve.sh with `set -a; . file` (the trailing comments rule out `docker --env-file`).
# PARALLEL=                     # requests sharing the rounds (serve.sh: --parallel; config/tp4.env's value, empty: the engine's auto), every rank the same
# CONTEXT=262144                # another window than serve.sh's default for this TP, every rank the same
# VISION=0                      # text alone (serve.sh: --vision; default 1: images and videos), every rank the same
# TF_HEAT_HIGH=92               # serve.sh's heat defaults (92, 88); empty values for none, every rank the same
TF_GLM_PREFILL_REDUCE=gather    # every rank the same: split sends each rank's rows to every other, which a ring without a switch cannot
MASTER=10.40.0.4                # rank 0's address on tp4host0
NCCL_NET_PLUGIN=none            # NCCL's own IB transport, as at TP=3
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA==rocep1s0f0:1,rocep1s0f1:1,roceP2p1s0f0:1,roceP2p1s0f1:1   # both ports, 2 rails each
NCCL_IB_GID_INDEX=3
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_SUBNET_AWARE_ROUTING=1  # each peer over the port whose /30 reaches it (NCCL 2.30.7)
NCCL_IB_MERGE_NICS=0            # each device of a port stays its own, as the graph names them
NCCL_ALGO=Ring                  # the ring alone
NCCL_GRAPH_FILE=/work/graph.xml # this rank's 4 channels: receive on the port toward the rank before, send toward the next
NCCL_RUNTIME_CONNECT=1          # connect on first use: at init NCCL 2.30.7 would also connect trees over the missing diagonals
NCCL_CUMEM_ENABLE=1             # NCCL 2.30.7 connects on first use only with cuMem, which the engine turns off unless set
NCCL_MIN_NCHANNELS=4            # 4 channels, as TP=3
NCCL_MAX_NCHANNELS=4
NCCL_SOCKET_IFNAME==tp4host0    # NCCL's bootstrap on 10.40.0.5/32, never the management Wi-Fi
NCCL_SOCKET_FAMILY=AF_INET
NCCL_DEBUG=INFO                 # NCCL logs each connection's transport once at start (SETUP §5 reads NET/IB)
NCCL_DEBUG_SUBSYS=INIT,NET
