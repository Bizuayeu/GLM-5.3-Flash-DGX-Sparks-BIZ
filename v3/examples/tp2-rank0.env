# TP=2 rank 0 on the reference pair (edgexpert01): copy to /work/rank.env on that host and put your own values.
# 参照機の対のTP=2 rank 0（edgexpert01）。そのホストの /work/rank.env にコピーし、自分の値に直す。
# The values are the reference pair's; 1.x uses the same link, HCA and GID.
# Sourced by serve.sh with `set -a; . file`.
# PARALLEL=                     # requests sharing the rounds (serve.sh: --parallel; default 1, empty: the engine's auto), every rank the same
# CONTEXT=262144                # another window than serve.sh's default for this TP, every rank the same
# TF_HEAT_HIGH=92               # serve.sh's heat defaults (92, 88, 93); empty values for none, every rank the same
# API_KEY_FILE=/work/api-key    # serving beyond loopback (rank 0): requests without the key are refused
NCCL_PORT=29583                 # rank 0's NCCL bootstrap port on MASTER (serve.sh: NCCL_COMM_ID), every rank the same
MASTER=10.41.12.1                               # rank 0's address on the direct link
NCCL_NET=IB                                     # named, as TP=3 and 1.x name it (2026-10-05: every connection was NET/IB either way)
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1        # 2 rails, the 2.x default (1 rail: rocep1s0f1 alone)
NCCL_IB_GID_INDEX=3                             # the RoCE v2 entry on these ports
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_MIN_NCHANNELS=4                            # 4 channels, as TP=3: decode +1%, about 1.5 GiB more room at start (decisions.md)
NCCL_MAX_NCHANNELS=4
NCCL_SOCKET_IFNAME=enp1s0f1np1              # bootstrap over the link's interface
NCCL_SOCKET_FAMILY=AF_INET
NCCL_DEBUG=INFO                 # NCCL logs each connection's transport once at start (SETUP §6 reads NET/IB)
NCCL_DEBUG_SUBSYS=INIT,NET
