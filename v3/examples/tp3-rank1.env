# TP=3 rank 1 on the reference ring (edgexpert02): copy to /work/rank.env on that host and put your own values.
# 参照機のリングのTP=3 rank 1（edgexpert02）。そのホストの /work/rank.env にコピーし、自分の値に直す。
# Measured 2026-10-03: rank 1 sends to rank 2 on rocep1s0f1+roceP2p1s0f1 and receives from rank 0 on
# rocep1s0f0+roceP2p1s0f0.
# Sourced by serve.sh with `set -a; . file` (the trailing comments rule out `docker --env-file`).
# PARALLEL=1                    # requests sharing the rounds (serve.sh: --parallel; default the engine's auto), every rank the same
# CONTEXT=262144                # another window than serve.sh's default for this TP, every rank the same
# TF_HEAT_HIGH=92               # serve.sh's heat defaults (92, 88, 93); empty values for none, every rank the same
# ID_FILE=/work/nccl-id         # rank 0 writes its NCCL id here and the others read it (cluster.sh copies it)
MASTER=10.40.0.1                # rank 0's address on tp3host0
NCCL_NET_PLUGIN=none            # NCCL's own IB transport (the image's default spcx also loads and measured the same)
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA==rocep1s0f0:1,rocep1s0f1:1,roceP2p1s0f0:1,roceP2p1s0f1:1   # 2 rails (1 rail: drop the roceP2 pair)
NCCL_IB_GID_INDEX=3
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_SUBNET_AWARE_ROUTING=1  # each peer over the port whose /30 reaches it (NCCL 2.30.7)
NCCL_MIN_NCHANNELS=4            # 4 channels (Mia's TP=3 setting): decode R=4 39 us, a 512-row piece 0.89 ms
NCCL_MAX_NCHANNELS=4
NCCL_SOCKET_IFNAME==tp3host0    # bootstrap and the TCPStore on 10.40.0.2/32, never the management Wi-Fi
NCCL_SOCKET_FAMILY=AF_INET
NCCL_DEBUG=INFO                 # NCCL logs each connection's transport once at start (SETUP §6 reads NET/IB)
NCCL_DEBUG_SUBSYS=INIT,NET
