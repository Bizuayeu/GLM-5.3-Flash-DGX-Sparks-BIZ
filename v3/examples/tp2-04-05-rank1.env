# TP=2 rank 1 on the pair 04-05 of the reference ring of four (edgexpert05): copy to /work/rank.env on that host
# and put your own values. The ring's hosts serve as two pairs, 04-05 and 06-07.
# 参照機の四台のリングの対 04-05 のTP=2 rank 1（edgexpert05）。そのホストの /work/rank.env にコピーし、自分の値に直す。
# The pair's link is edgexpert04's port 2 to edgexpert05's port 2. Served at TP=2 from 2026-11-07.
# Sourced by serve.sh with `set -a; . file`.
# PARALLEL=                     # requests sharing the rounds (serve.sh: --parallel; config/tp2.env's value, empty: the engine's auto), every rank the same
# CONTEXT=262144                # another window than config/tp2.env's, every rank the same
# VISION=0                      # text alone (serve.sh: --vision; default 1: images and videos), every rank the same
# TF_HEAT_HIGH=92               # serve.sh's heat defaults (92, 88); empty values for none, every rank the same
NCCL_PORT=29583                 # rank 0's NCCL bootstrap port on MASTER (serve.sh: NCCL_COMM_ID), every rank the same
MASTER=10.41.45.1                               # rank 0's address on the direct link
NCCL_NET=IB                                     # named, as TP=3 and 1.x name it (2026-10-05: every connection was NET/IB either way)
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1        # 2 rails: the link's port, both devices (1 rail: rocep1s0f1 alone)
NCCL_IB_GID_INDEX=3                             # the RoCE v2 entry on these ports
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_MIN_NCHANNELS=4                            # 4 channels, as TP=3 (measured on 2.x: v2/docs/decisions.md; on 3.x: v3/docs/decisions.md)
NCCL_MAX_NCHANNELS=4
NCCL_SOCKET_IFNAME=enp1s0f1np1              # bootstrap over the link's interface
NCCL_SOCKET_FAMILY=AF_INET
NCCL_DEBUG=INFO                 # NCCL logs each connection's transport once at start (SETUP §5 reads NET/IB)
NCCL_DEBUG_SUBSYS=INIT,NET
